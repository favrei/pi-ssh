# pi runs `npm install --omit=dev` inside this checkout on every
# `pi update --extensions`. That install has nothing to fix here:
#   - audit noise comes from the host pi install's own dependency tree,
#     which this extension neither owns nor can update;
#   - funding lines are pure noise in an automated update.
audit=false
fund=false

# Extensions resolve @earendil-works/pi-* through pi's loader at runtime.
# Never let npm auto-install those peers into this checkout.
legacy-peer-deps=true
